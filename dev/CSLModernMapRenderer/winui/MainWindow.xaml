<Window
    x:Class="CSLModernMapWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ribbon="using:RibbonSpace.Controls">
<Grid x:Name="Root" Background="{ThemeResource WorkspaceWindowSurfaceBrush}">
    <Grid.Resources>
        <DataTemplate x:Key="ThemePreviewTemplate">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
                <Image Source="{Binding Preview}" Width="76" Height="38" />
                <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="82" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PoiStylePreviewTemplate">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
                <Image Source="{Binding Preview}" Width="76" Height="38" />
                <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="Transparent">
            <TitleBar x:Name="AppTitleBar" Title="CSLModernMap" Height="40" Background="Transparent">
                <TitleBar.IconSource>
                    <SymbolIconSource Symbol="Map" />
                </TitleBar.IconSource>
                <TitleBar.RightHeader>
                    <Button x:Name="LanguageButton" Background="Transparent" BorderThickness="0" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="World" />
                            <TextBlock x:Name="LanguageName" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </TitleBar.RightHeader>
            </TitleBar>
        </Border>
        <Border Grid.Row="1" Background="Transparent">
            <ribbon:Ribbon x:Name="Ribbon" Background="Transparent" />
        </Border>
        <Grid x:Name="WorkspaceGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SettingsColumn" Width="290" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="290" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource WorkspaceSidebarSurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel x:Name="SettingsHeader" Padding="12,10,12,0" Spacing="8" Visibility="Collapsed" />
                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel Padding="12" Spacing="10"><Button x:Uid="MainWindow_OverviewButton" x:Name="OverviewButton"  HorizontalAlignment="Stretch"/><StackPanel x:Name="SettingsPanel" Spacing="10" /></StackPanel></ScrollViewer>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <InfoBar x:Name="OperationError" IsOpen="False" Severity="Error" IsClosable="True" />
                    <InfoBar x:Name="PreviewLoadingNotice" IsOpen="False" Severity="Warning" IsClosable="False" />
                </StackPanel>
                <Grid Grid.Row="1" Padding="8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="MainWindow_ContextText" x:Name="ContextText"  />
                        <Grid x:Name="ViewerToolbar" ColumnSpacing="6" RowSpacing="6" />
                    </StackPanel>
                    <Button x:Uid="MainWindow_InspectorToggle" x:Name="InspectorToggle" Grid.Column="1"  VerticalAlignment="Top" />
                </Grid>
                <Grid Grid.Row="2">
                <WebView2 x:Name="MapView" />
                <Grid x:Name="RmpWorkspace" Visibility="Collapsed" Background="White" />
                <Border x:Name="MapOverlay" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="12" MaxWidth="520" Margin="24">
                        <ProgressRing x:Name="MapOverlaySpinner" Width="36" Height="36" IsActive="False" HorizontalAlignment="Center" />
                        <TextBlock x:Uid="MainWindow_MapOverlayText" x:Name="MapOverlayText"  FontSize="18"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                        <TextBlock x:Name="MapOverlayDetail" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
                        <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                        <Button x:Name="MapOverlayCancel" Visibility="Collapsed" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Cancel" />
                                <TextBlock x:Uid="MainWindow_5"  />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>
            <Border x:Name="InspectorBorder" Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource WorkspaceSidebarSurfaceBrush}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button x:Uid="MainWindow_InspectorClose" x:Name="InspectorClose"  HorizontalAlignment="Right" Margin="8"/><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="InspectorPanel" Padding="12" Spacing="10">
                    <TextBlock x:Uid="MainWindow_7"  FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Uid="MainWindow_InspectorText" TextWrapping="Wrap" />
                </StackPanel></ScrollViewer></Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Padding="12,6" Background="{ThemeResource WorkspaceSidebarSurfaceBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ProgressRing x:Name="StatusSpinner" Width="16" Height="16" Margin="0,0,8,0"
                          IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
            <TextBlock x:Uid="MainWindow_StatusText" x:Name="StatusText" Grid.Column="1"  TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
